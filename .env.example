# ==============================================================================
# GrievEase Environment Variables Template
# Copy this file to .env and configure values before starting services.
# NEVER commit .env with real secrets to version control.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=4000

# Base URLs and Routing (Do NOT hardcode domains in application code)
BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# Cookie Configuration
# In production on a custom domain, set COOKIE_DOMAIN to your domain (e.g., .clientdomain.org)
COOKIE_DOMAIN=localhost

# HSTS Configuration
# ONLY enable HSTS when the site is running behind a validated HTTPS domain
HSTS_ENABLED=false

# Database Configuration (PostgreSQL 15+)
DATABASE_URL=postgresql://grievease_user:local_dev_secret_replace_in_prod@localhost:5432/grievease_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=grievease_user
DB_PASSWORD=local_dev_secret_replace_in_prod
DB_NAME=grievease_db

# Redis Cache and Rate Limiting
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=local_redis_secret_replace_in_prod

# Cryptographic Keys & Secrets (Generate with `openssl rand -hex 32`)
JWT_SECRET=dev_jwt_secret_must_be_changed_in_production_environment_32chars!
REFRESH_TOKEN_SECRET=dev_refresh_secret_must_be_changed_in_prod_environment_32chars!
SECURITY_PEPPER=dev_security_pepper_for_hashing_answers_min_32_characters_here!
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Account Recovery Delay Configuration (in hours)
RECOVERY_DELAY_HOURS=24

# First-Run Super Admin Bootstrap Mode ('token' or 'env')
# 'token' (default): Run `pnpm admin:bootstrap` to generate a single-use 256-bit setup token.
# 'env': Read credentials only once if no super admin exists, then disable setup.
BOOTSTRAP_MODE=token
BOOTSTRAP_SUPERADMIN_USERNAME=
BOOTSTRAP_SUPERADMIN_PASSWORD=

# Feature Flags (All external adapters are disabled by default per client requirement)
FEATURE_REGISTER_SOCIETY=false
FEATURE_EMAIL_ADAPTER=false
FEATURE_SMS_ADAPTER=false
