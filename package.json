{
  "name": "grievease-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @grievease/* dev",
    "dev:web": "pnpm --filter @grievease/web dev",
    "dev:api": "pnpm --filter @grievease/api dev",
    "build": "node scripts/check-i18n.js && pnpm --filter @grievease/contracts build && pnpm --filter @grievease/ui build && pnpm --filter @grievease/api build && pnpm --filter @grievease/web build && node scripts/check-bundle-size.js",
    "lint": "node scripts/check-i18n.js && pnpm -r lint",
    "lint:i18n": "node scripts/check-i18n.js",
    "check:bundle": "node scripts/check-bundle-size.js",
    "type-check": "pnpm -r type-check",
    "test": "pnpm -r test",
    "test:unit": "pnpm --filter @grievease/api test:unit",
    "test:integration": "pnpm --filter @grievease/api test:integration",
    "test:e2e": "pnpm --filter @grievease/web test:e2e",
    "db:generate": "pnpm --filter @grievease/api db:generate",
    "db:migrate": "pnpm --filter @grievease/api db:migrate",
    "db:seed": "pnpm --filter @grievease/api db:seed",
    "admin:bootstrap": "pnpm --filter @grievease/api admin:bootstrap",
    "admin:emergency-transfer": "pnpm --filter @grievease/api admin:emergency-transfer",
    "audit:verify": "pnpm --filter @grievease/api audit:verify",
    "analytics:rebuild": "pnpm --filter @grievease/api analytics:rebuild",
    "seed:analytics": "pnpm --filter @grievease/api seed:analytics",
    "secret-scan": "node scripts/secret-scan.js",
    "claims:audit": "node scripts/claims-audit.js",
    "routes:report": "node scripts/routes-report.js",
    "backup:verify": "node scripts/backup-verify.js",
    "smoke": "node scripts/smoke-test.js",
    "guard:no-marathi": "node scripts/guard-no-marathi.js",
    "i18n:import-review": "node scripts/import-review.js",
    "preflight": "node scripts/preflight.js"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
