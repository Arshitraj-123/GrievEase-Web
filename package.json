{
  "name": "grievease-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @grievease/* dev",
    "dev:web": "pnpm --filter @grievease/web dev",
    "dev:api": "pnpm --filter @grievease/api dev",
    "build": "pnpm --filter @grievease/contracts build && pnpm --filter @grievease/ui build && pnpm --filter @grievease/api build && pnpm --filter @grievease/web build",
    "lint": "pnpm -r lint",
    "type-check": "pnpm -r type-check",
    "test": "pnpm -r test",
    "test:unit": "pnpm --filter @grievease/api test:unit",
    "test:integration": "pnpm --filter @grievease/api test:integration",
    "test:e2e": "pnpm --filter @grievease/web test:e2e",
    "db:generate": "pnpm --filter @grievease/api db:generate",
    "db:migrate": "pnpm --filter @grievease/api db:migrate",
    "db:seed": "pnpm --filter @grievease/api db:seed",
    "admin:bootstrap": "pnpm --filter @grievease/api admin:bootstrap",
    "admin:emergency-transfer": "pnpm --filter @grievease/api admin:emergency-transfer",
    "audit:verify": "pnpm --filter @grievease/api audit:verify",
    "secret-scan": "node scripts/secret-scan.js"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
