{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 4,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "API Request Rate (RPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m])) by (status)",
          "legendFormat": "HTTP {{status}}"
        }
      ]
    },
    {
      "title": "API Latency (P95 & P99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "P95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "P99"
        }
      ]
    },
    {
      "title": "Active WebSocket Connections",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "socket_io_connected_clients",
          "legendFormat": "Sockets"
        }
      ]
    },
    {
      "title": "Failed Logins & PoW Challenges",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 8 },
      "targets": [
        {
          "expr": "rate(auth_login_failures_total[5m])",
          "legendFormat": "Failed Logins/s"
        },
        {
          "expr": "rate(auth_pow_challenges_total[5m])",
          "legendFormat": "PoW Challenges/s"
        }
      ]
    },
    {
      "title": "Database Connection Pool",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "pg_stat_activity_count",
          "legendFormat": "Active Connections"
        }
      ]
    },
    {
      "title": "Redis Memory Usage",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 8 },
      "targets": [
        {
          "expr": "redis_memory_used_bytes / redis_memory_max_bytes * 100",
          "legendFormat": "% Used"
        }
      ]
    },
    {
      "title": "Audit Chain Verification Status",
      "type": "stat",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "grievease_audit_chain_verified",
          "legendFormat": "Chain Status (1=OK)"
        }
      ]
    },
    {
      "title": "Background Worker Job Failures",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "expr": "rate(bullmq_job_failures_total[5m])",
          "legendFormat": "{{queue}} Failures"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["grievease", "production", "monitoring"],
  "time": { "from": "now-1h", "to": "now" },
  "title": "GrievEase Production Observability"
}

